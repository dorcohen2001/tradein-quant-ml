# TRADEIN Environment Variables Template
# Copy this file to .env and fill in your values.

# Telegram Bot configuration for live alerts
TELEGRAM_BOT_TOKEN="your_bot_token_here"
TELEGRAM_CHAT_ID="your_chat_id_here"

# Optional: Dedicated routes per model (uncomment to direct specific models to separate channels)
# TELEGRAM_ROUTE_LIVNE_CHAT_ID="-100xxxxxxxxxx"
# TELEGRAM_ROUTE_LIVNE_TOKEN="optional_dedicated_token"
# TELEGRAM_ROUTES='{"livne":{"chat_id":"-100111"},"biton":{"chat_id":"-100222"}}'

# Optional: News API key (falls back to Google News RSS if unset)
NEWSAPI_KEY=""
