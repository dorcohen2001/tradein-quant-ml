# Single .gitignore for the whole repository. Previously there were three
# (root, TRADEIN/, backuptrade1/) with overlapping and already-stale rules
# pointing at paths that no longer exist.

# --- Secrets -------------------------------------------------------------
.env
**/.env

# --- Python --------------------------------------------------------------
__pycache__/
*.pyc

# --- Runtime state -------------------------------------------------------
# Everything mutable now lives under runtime/. Ignored wholesale rather than
# rule-by-rule, so a new artifact type can't silently start being committed.
# The one deliberate exception: .gitkeep files, so the directory skeleton is
# versioned and a fresh clone starts with the layout already in place.
runtime/*
!runtime/.gitkeep
!runtime/*/
runtime/*/*
!runtime/*/.gitkeep
!runtime/cache/*/
runtime/cache/*/*
!runtime/cache/*/.gitkeep

# --- Generated reports / narratives --------------------------------------
mail/reports/
agents/steve/narrative_*.md
