# Single .gitignore for the whole repository. Previously there were three
# (root, TRADEIN/, backuptrade1/) with overlapping and already-stale rules
# pointing at paths that no longer exist.

# --- Secrets -------------------------------------------------------------
.env
**/.env

# --- Python --------------------------------------------------------------
__pycache__/
*.pyc

# --- Runtime state -------------------------------------------------------
# Everything mutable now lives under runtime/. Ignored wholesale rather than
# rule-by-rule, so a new artifact type can't silently start being committed.
# The one deliberate exception: .gitkeep files, so the directory skeleton is
# versioned and a fresh clone starts with the layout already in place.
runtime/*
!runtime/.gitkeep
!runtime/*/
runtime/*/*
!runtime/*/.gitkeep
!runtime/cache/*/
runtime/cache/*/*
!runtime/cache/*/.gitkeep

# --- Backtest candle cache -----------------------------------------------
# core/backtesting downloads intraday OHLCV here once and reuses it across
# runs and across both models. It is pure derived data (re-downloadable from
# Binance/Yahoo at any time) and gets large fast -- a year of 5m candles for
# one crypto watchlist is millions of rows.
data/

# --- Generated reports / narratives --------------------------------------
mail/reports/
agents/steve/narrative_*.md

# --- Backup archives ------------------------------------------------------
# scripts/backup_manager.py writes timestamped .zip snapshots here. They are
# large, they duplicate content git already versions, and a `full` archive
# deliberately contains the repo-root .env -- committing one would push the
# Telegram bot token straight into history. The directory skeleton is kept via
# .gitkeep so a fresh clone has somewhere to write.
backups/*
!backups/.gitkeep
!backups/*/
backups/*/*
!backups/*/.gitkeep
